# Copy to .env.local and fill in. Never commit real secrets.
# See README for where each value comes from.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: cron routes, webhooks, admin scripts ONLY. Never browser-exposed.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=https://prox.app
# Shared secret protecting /api/cron/* (Supabase scheduler sends it as a Bearer token).
CRON_SECRET=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
# Webhook signing secret for /api/billing/webhook (dashboard or `stripe listen`).
STRIPE_WEBHOOK_SECRET=
# Optional: use a dashboard Price instead of the inline $199/yr price_data.
STRIPE_PRICE_ID=
# Trial length in days for new subscriptions (0 = no trial).
BILLING_TRIAL_DAYS=7

# --- AI deal titles (Ollama-compatible /api/generate) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
